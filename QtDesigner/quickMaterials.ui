          <property name="styleSheet">
           <string notr="true">QPushButton {
    font-family: 'Segoe UI';  /* Sets the font to Segoe UI */
    font-size: 16px;  /* Adjust the font size as needed */
    color: #999999;  /* Faded grey text when unchecked */
    background-color: transparent;  /* Transparent background */
    border: none;  /* Remove border entirely */
    border-radius: 8px;
    padding: 0px;  /* Small padding to center icon */
    margin: 0px;
    qproperty-iconSize: 18px 18px;  /* Make icon larger */
    image: url(&quot;:/icons/settings_icon.png&quot;); /* Default icon */
}

/* Hover keeps normal icon, optional glow or border */
QPushButton:hover {
    border: none;
    background-color: transparent;
}

/* Pressed version of the icon */
QPushButton:pressed {
    image: url(&quot;:/icons/settings_icon_pressed.png&quot;);
    background-color: transparent;
    border: none;
}

QPushButton:unchecked {
    font-family: 'Segoe UI';  /* Sets the font to Segoe UI */
    font-size: 10px;  /* Adjust the font size as needed */
    color: #111111;  /* Faded grey text when unchecked */
    background-color: #3a3a3a;  /* Light grey background when unchecked */
    border: 0px solid #ffffff;  /* Optional border */
    border-radius: 8px;  /* Rounded corners */

}

QPushButton:hover:checked {
    border: 0px solid #00f7c8;  /* Optional white border on hover when checked */
}
</string>
          </property>
          <property name="text">
           <string/>
          </property>
          <property name="icon">

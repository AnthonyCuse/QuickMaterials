                   <property name="styleSheet">
                    <string notr="true">QPushButton#colorDisplayButton {
    background-color: #888888;
    color: #ffffff;
    border: 2px solid #333333;
    border-radius: 10px;  /* Rounded corners */
    min-height: 1px;  /* Minimum height for the button */
    padding: 2px 2px;  /* Padding inside the button */
	margin: 0px;
}

QPushButton#colorDisplayButton:hover {
    border: 2px solid #ffffff;
}

QPushButton#colorDisplayButton:pressed {
    background-color: #333333;  /* Change color on press */
    border: 2px solid #222222;
}
</string>

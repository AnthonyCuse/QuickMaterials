                   <property name="styleSheet">
                    <string notr="true">QPushButton {
    font-family: 'Segoe UI';  /* Sets the font to Segoe UI */
    font-size: 18px;  /* Adjust the font size as needed */
    color: #999999;  /* Faded grey text when unchecked */
    background-color: #666666;  /* Transparent background */
    border: 1px solid #666666;  /* Remove border entirely */
    border-radius: 4px;
    padding:1px;  /* Small padding to center icon */
    padding-right: -8px;  /* Small padding to center icon */
    padding-left: -8px;  /* Small padding to center icon */
    margin: 0px;
    qproperty-iconSize: 15px 15px;  /* Make icon larger */
    image: url(&quot;:/icons/shaders_icon.png&quot;); /* Default icon */
}

/* Hover keeps normal icon, optional glow or border */
QPushButton:hover {
    background-color: #777777;
}

/* Pressed version of the icon */
QPushButton:pressed {
    image: url(&quot;:/icons/shaders_icon_checked.png&quot;);
    background-color: 333333;
    border: none;
}

QPushButton:checked {
    border: 1px solid #7dffe6;  /* Optional white border on hover when checked */
    background-color: #333333;  /* Transparent background */
    image: url(&quot;:/icons/shaders_icon_checked.png&quot;);

}

</string>

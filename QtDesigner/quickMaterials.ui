                    <bool>false</bool>
                   </property>
                   <property name="styleSheet">
                    <string notr="true">QDoubleSpinBox {
    font-family: 'Segoe UI';
    font-size: 12px;
    color: #ffffff;
    background-color: #404040;
    border: 1px solid #444444;
    border-radius: 7px;             /* Rounded field */
    padding: 2px 5px;               /* Text padding (fixed missing colon) */
    padding-right: 2px;            /* Reserve space for the buttons */
    min-height: 5px;               /* Avoid vertical clipping */
    min-width: 30px;
    margin: 2px 0;
    selection-background-color: transparent;
    selection-color: #ffffff;   /* keep text readable */

}

/* Define button sizes/placement so padding-right matches them */
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 12px;                    /* Button width */
    border: none;
    background: transparent;        /* Keep your look; arrows are default */
}

QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    margin: 0px 0px 0 0;        /* Tighter to text */
}

QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    margin: 0px 0px 0 0;        /* Tighter to text */
}

QDoubleSpinBox::up-arrow   { 
    image: url(&quot;:/icons/arrow_up.png&quot;);   
    width: 10px; height: 10px; 
    margin: 3px 10px 0 0; 
}

QDoubleSpinBox::down-arrow { 
    image: url(&quot;:/icons/arrow_down.png&quot;); 
    width: 10px; height: 10px; 
    margin: -3px 10px 0 0; 
}

/* Alternate icons when pressed */
QDoubleSpinBox::up-arrow:pressed {
    image: url(&quot;:/icons/arrow_pressed_up.png&quot;);
}
QDoubleSpinBox::down-arrow:pressed {
    image: url(&quot;:/icons/arrow_pressed_down.png&quot;);
}


/* NOTE: No ::up-arrow / ::down-arrow blocks here, so Qt draws the default arrows */
</string>

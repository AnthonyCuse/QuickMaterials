             <property name="styleSheet">
              <string notr="true">QScrollArea#materialsListScrollArea {
    border: 2px solid #444444;               /* Border around the scroll area */
    border-radius: 10px;                     /* Rounded corners */
    background-color: #383838;               /* Background color of the scroll area */
}

QScrollArea::viewport {
    border: none;                            /* Remove border inside the viewport */
    background-color: #383838;               /* Background of the viewport */
    border-radius: 0px;                     /* Match the parent scroll area rounded corners */
}

QScrollBar:vertical {
    border: 1px solid #666666;               /* Border for vertical scrollbar */
    background: #444444;                     /* Background color for vertical scrollbar */
    width: 12px;                             /* Set the width of the vertical scrollbar */
    margin: 3px 0 3px 0;                     /* Margin between the scrollbar and the scroll area */
    border-radius: 6px;                      /* Rounded corners for the scrollbar */
}

QScrollBar::handle:vertical {
    background: #888888;                     /* Handle color */
    border-radius: 6px;                      /* Rounded handle */
    min-height: 20px;                        /* Minimum height for handle */
}

QScrollBar::handle:vertical:hover {
    background: #aaaaaa;                     /* Hover state for handle */
}

QScrollBar::handle:vertical:pressed {
    background: #666666;                     /* Pressed state for handle */
}

QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;                            /* Remove arrow buttons */
    background: none;                        /* Transparent background */
}

QScrollBar:horizontal {
    border: 1px solid #666666;               /* Border for horizontal scrollbar */
    background: #444444;                     /* Background color for horizontal scrollbar */
    height: 12px;                            /* Set the height of the horizontal scrollbar */
    margin: 0 3px 0 3px;                     /* Margin between the scrollbar and the scroll area */
    border-radius: 6px;                      /* Rounded corners for the scrollbar */
}

QScrollBar::handle:horizontal {
    background: #888888;                     /* Handle color */
    border-radius: 6px;                      /* Rounded handle */
    min-width: 20px;                         /* Minimum width for handle */
}

QScrollBar::handle:horizontal:hover {
    background: #aaaaaa;                     /* Hover state for handle */
}

QScrollBar::handle:horizontal:pressed {
    background: #666666;                     /* Pressed state for handle */
}

QScrollBar::sub-line:horizontal, QScrollBar::add-line:horizontal {
    border: none;                            /* Remove arrow buttons */
    background: none;                        /* Transparent background */
}
</string>
             </property>

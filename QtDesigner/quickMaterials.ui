          <property name="styleSheet">
           <string notr="true">QPushButton {
    font-family: 'Segoe UI';  /* Sets the font to Segoe UI */
    font-size: 12px;  /* Adjust the font size as needed */
    color: #999999;  /* Faded grey text when unchecked */
    background-color: #444444;  /* Light grey background when unchecked */
    border: 0px solid #444444;  /* Optional border with dark grey color */
    border-radius: 8px;  /* Rounded corners */
    padding: 4px 4px;  /* Padding around the text */
}

QPushButton:hover {
    border: 0px solid #00f7c8;  /* Optional white border on hover */
}

QPushButton:pressed {
    background-color: #1a1a1a;  /* Darker background when pressed */
}

QPushButton:checked {
    font-family: 'Segoe UI';  /* Sets the font to Segoe UI */
    font-size: 12px;  /* Adjust the font size as needed */
    font-weight: bold;  /* Make text bold when checked */
    color: #ededed;  /* White text color when checked */
    background-color: #666666;  /* Dark grey background when checked */
    border: 0px solid #00f7c8;  /* Optional white border */
    border-radius: 8px;  /* Rounded corners */
}


QPushButton:unchecked {
    font-family: 'Segoe UI';  /* Sets the font to Segoe UI */
    font-size: 12px;  /* Adjust the font size as needed */
    color: #111111;  /* Faded grey text when unchecked */
    background-color: #3a3a3a;  /* Light grey background when unchecked */
    border: 0px solid #ffffff;  /* Optional border */
    border-radius: 8px;  /* Rounded corners */

}

QPushButton:hover:checked {
    border: 0px solid #00f7c8;  /* Optional white border on hover when checked */
}
</string>

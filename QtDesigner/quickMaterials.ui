                      <property name="styleSheet">
                       <string notr="true">QScrollArea#materialsListScrollArea {
    border-radius: 0px;                     /* Rounded corners */
    background-color: #333333;               /* Background color of the scroll area */
}

QScrollArea::viewport {
    border: none;                            /* Remove border inside the viewport */
    background-color: #333333;               /* Background of the viewport */
    border-radius: 0px;                     /* Match the parent scroll area rounded corners */
}

QScrollBar:vertical {
    border: 0px solid #333333;               /* Border for vertical scrollbar */
    background: #222222;                     /* Background color for vertical scrollbar */
    width: 12px;                             /* Set the width of the vertical scrollbar */
    margin: -10px 0px 0px 0px; 
	margin-top: -10px;
    border-radius: 5px;                      /* Rounded corners for the scrollbar */
}

QScrollBar::handle:vertical {
    background: #555555;                     /* Handle color */
    min-height: 20px;                        /* Minimum height for handle */
    border-width: 0px;
    border-radius: 4px;
	padding: 0px;
}

QScrollBar::handle:vertical:hover {
    background: #aaaaaa;                     /* Hover state for handle */
}

QScrollBar::handle:vertical:pressed {
    background: #666666;                     /* Pressed state for handle */
}

QScrollBar::sub-line:vertical, QScrollBar::add-line:vertical {
    border: none;                            /* Remove arrow buttons */
    background: none;                        /* Transparent background */
}

</string>

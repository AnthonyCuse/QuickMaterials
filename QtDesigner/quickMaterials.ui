             <property name="toolTip">
              <string>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'MS Shell Dlg 2'; font-size:8pt; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Open the settings in the top right to edit optional prefix and suffix. (Default 'M_')&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Naming Key:&lt;br /&gt;(selection) = include name of selected mesh(s) or group(s) (if multiple selections, adds name of first selected)&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;(shadertype) = material type (standardSurface, blinn, phong, etc.)&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;(scene): current Maya scene file name without extension, or &amp;quot;untitled&amp;quot;&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;(project): current Maya project folder name&lt;/p&gt;
&lt;p style=&quot; margin-top:12px; margin-bottom:12px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;(color):  color of the material  (e.g., red, orange, blue)&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="styleSheet">
              <string notr="true">QLineEdit {
    font-family: 'Segoe UI';
    font-size: 12px;
    color: #ffffff;
    background-color: #2a2a2a;  /* Retaining the original background color */
    border: 0px solid #444444;
    border-radius: 8px;
    padding: 2px 3px;
}

QLineEdit:hover {
    background-color: #222222;
}

QLineEdit:focus {
    border: 0px solid #555555;
    background-color: #44444;
}

QLabel {
    font-family: 'Segoe UI';
    font-size: 14px;  /* Same larger font size as QLineEdit */
    color: #ffffff;
    background-color: #444444;  /* Matching background color */
    border: 2px solid #444444;
    border-radius: 8px;
    padding: 4px 5px;
}

QLabel:hover {
    background-color: #f5f5f5;
}</string>

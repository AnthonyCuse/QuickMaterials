QCheckBox::indicator:unchecked:hover {
    border: 1px solid #ffffff;
}

QCheckBox::indicator:checked:pressed,
QCheckBox::indicator:unchecked:pressed {
    background-color: #ffffff;
    border: 1px solid #ffffff;
}

/* Disabled state */
QCheckBox:disabled {
    color: #666666;
    background-color: #3a3a3a;
    border-radius: 6px;
    padding: 2px 6px;
}
</string>

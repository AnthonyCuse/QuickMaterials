                 <property name="styleSheet">
                  <string notr="true">QSlider::groove:horizontal {
    border: 0px solid #999999;
    background: qlineargradient(
        spread:pad, 
        x1:0, y1:0, 
        x2:1, y2:0, 
        stop:0 red, 
        stop:0.17 orange, 
        stop:0.33 yellow, 
        stop:0.5 green, 
        stop:0.67 blue, 
        stop:0.83 indigo, 
        stop:1 red  /* Return to red at the end */
    );
    height: 10px;   
    border-radius: 5px;
}

QSlider::handle:horizontal {
    background: #000000;
    border: 1px solid #555555;
    width: 3px;          /* Thinner handle */
    height: 10px;         /* Taller handle */
    margin: -6px 0;       /* Adjust the margin for better alignment */
    border-radius: 0px;   /* More rounded handle */
}

QSlider::sub-page:horizontal {
    background: transparent;
}

QSlider::add-page:horizontal {
    background: transparent;
}
</string>
                 </property>

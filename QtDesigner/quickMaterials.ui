               <property name="styleSheet">
                <string notr="true">QDoubleSpinBox {
    font-family: 'Segoe UI';                /* Use consistent font */
    font-size: 12px;                        /* Smaller font size */
    color: #ffffff;                         /* Text color */
    background-color: #333333;              /* Background color */
    border: 1px solid #444444;              /* Thinner border */
    border-radius: 6px;                     /* Smaller rounded corners */
    padding: 4px 6px;                       /* Less padding for a compact look */
    height: 5px;                            /* Smaller height */
    min-width: 30px;                        /* Minimum width to keep it compact */
    margin: 4px 0px;
}
</string>

               </property>
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Determines the roughness of the newly created materials.&lt;/p&gt;&lt;p&gt;0 - Shiny&lt;/p&gt;&lt;p&gt;1- Rough&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="styleSheet">
                <string notr="true">QSlider {
    min-height: 20px;  /* Minimum height of the slider */
    border: 2px solid #444444;  /* Outer border */
    border-radius: 8px;  /* Rounded corners for the slider */
    background: #333333;  /* Handle color */
	padding: 2px;
}

QSlider::hover {
    min-height: 20px;  /* Minimum height of the slider */
    border: 2px solid #444444;  /* Outer border */
    border-radius: 8px;  /* Rounded corners for the slider */
    background: #333333;  /* Handle color */
	padding: 2px;
	QSlider::handle:horizontal:hover {
    background: #ffffff;  /* Handle color on hover */
}
}

QSlider::groove:horizontal {
    border: 0px solid #666666;  /* Outer border for groove */
    height: 8px;  /* Groove height */
    background: #262626;  /* Groove background */
    border-radius: 4px;  /* Slightly rounded corners */
}

QSlider::handle:horizontal {
    background: #555555;  /* Handle color */
    border: 2px solid #666666;  /* Handle border */
    width: 18px;  /* Handle width */
    height: 18px;  /* Handle height */
    margin: -6px 0;  /* Align handle with groove */
    border-radius: 9px;  /* Fully rounded handle */
}

QSlider::handle:horizontal:hover {
    background: #888888;  /* Handle color on hover */
}

QSlider::handle:horizontal:pressed {
    background: #aaaaaa;  /* Handle color when pressed */
}

QSlider::add-page:horizontal {
    background: #333333;  /* Background color for the right side of the slider */
}

QSlider::sub-page:horizontal {
    background: #555555;  /* Background color for the left side of the slider */
}


</string>

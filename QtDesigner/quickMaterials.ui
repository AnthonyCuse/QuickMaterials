                 <item>
                  <widget class="QDoubleSpinBox" name="roughnessSpinBox">
                   <property name="sizePolicy">
                    <sizepolicy hsizetype="Minimum" vsizetype="Minimum">
                     <horstretch>0</horstretch>
                     <verstretch>0</verstretch>
                    </sizepolicy>
                   </property>
                   <property name="minimumSize">
                    <size>
                     <width>39</width>
                     <height>15</height>
                    </size>
                   </property>
                   <property name="autoFillBackground">
                    <bool>false</bool>
                   </property>
                   <property name="styleSheet">
                    <string notr="true">QDoubleSpinBox {
    font-family: 'Segoe UI';
    font-size: 12px;
    color: #ffffff;
    background-color: #404040;
    border: 1px solid #444444;
    border-radius: 7px;             /* Rounded field */
    padding: 2px 5px;               /* Text padding (fixed missing colon) */
    padding-right: 2px;            /* Reserve space for the buttons */
    min-height: 5px;               /* Avoid vertical clipping */
    min-width: 30px;
    margin: 2px 0;
    selection-background-color: transparent;
    selection-color: #ffffff;   /* keep text readable */

}

/* Define button sizes/placement so padding-right matches them */
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 12px;                    /* Button width */
    border: none;
    background: transparent;        /* Keep your look; arrows are default */
}

QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    margin: 0px 0px 0 0;        /* Tighter to text */
}

QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    margin: 0px 0px 0 0;        /* Tighter to text */
}

QDoubleSpinBox::up-arrow   { 
    image: url(&quot;:/icons/arrow_up.png&quot;);   
    width: 10px; height: 10px; 
    margin: 3px 10px 0 0; 
}

QDoubleSpinBox::down-arrow { 
    image: url(&quot;:/icons/arrow_down.png&quot;); 
    width: 10px; height: 10px; 
    margin: -3px 10px 0 0; 
}

/* Alternate icons when pressed */
QDoubleSpinBox::up-arrow:pressed {
    image: url(&quot;:/icons/arrow_pressed_up.png&quot;);
}
QDoubleSpinBox::down-arrow:pressed {
    image: url(&quot;:/icons/arrow_pressed_down.png&quot;);
}


/* NOTE: No ::up-arrow / ::down-arrow blocks here, so Qt draws the default arrows */
</string>
                   </property>
                   <property name="maximum">
                    <double>1.000000000000000</double>
                   </property>
                   <property name="singleStep">
                    <double>0.100000000000000</double>
                   </property>
                  </widget>
                 </item>
                 <item>
                  <widget class="QSlider" name="roughnessSlider">
                   <property name="sizePolicy">
                    <sizepolicy hsizetype="MinimumExpanding" vsizetype="Fixed">
                     <horstretch>0</horstretch>
                     <verstretch>0</verstretch>
                    </sizepolicy>
                   </property>
                   <property name="acceptDrops">
                    <bool>false</bool>
                   </property>
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Determines the roughness of the newly created materials.&lt;/p&gt;&lt;p&gt;0 - Shiny&lt;/p&gt;&lt;p&gt;1- Rough&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="autoFillBackground">
                    <bool>false</bool>
                   </property>
                   <property name="styleSheet">
                    <string notr="true">QSlider {
    padding: 0px;
    border: #333333;  /* Clean slider background */
    background: #404040;  /* Avoid filling behind groove */
    border-radius: 6px;
    height:15px;
    width: 10px;   
}

QSlider::groove:horizontal {
    border: 0px;
    height:4px;  /* Groove height (make this smaller for thinner bar) */
    background: #262626;
    border-radius: 2px;
}


QSlider::handle:horizontal {
    background: #e0e0e0;
    border: 1px solid #555555;
    width: 10px;        /* Round handle size */
    height: 10px;
    margin: -4px 0;     /* Centers the handle on thin groove */
    border-radius: 5px; /* Fully rounded handle */

}

QSlider::handle:horizontal:hover {
    background: #ffffff;
}

QSlider::handle:horizontal:pressed {
    background: #aaaaaa;
}

QSlider::add-page:horizontal {
    background: #222222;
}

QSlider::sub-page:horizontal {
    background: #777777;
}
</string>
                   </property>

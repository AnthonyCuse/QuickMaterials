           <item>
            <widget class="QPushButton" name="textureImporterSettingsButton">
             <property name="sizePolicy">
              <sizepolicy hsizetype="Minimum" vsizetype="Minimum">
               <horstretch>0</horstretch>
               <verstretch>0</verstretch>
              </sizepolicy>
             </property>
             <property name="minimumSize">
              <size>
               <width>15</width>
               <height>0</height>
              </size>
             </property>
             <property name="font">
              <font>
               <family>Segoe UI</family>
               <pointsize>-1</pointsize>
              </font>
             </property>
             <property name="styleSheet">
              <string notr="true">QPushButton {
    font-family: 'Segoe UI';  /* Sets the font to Segoe UI */
    font-size: 12px;  /* Adjust the font size as needed */
    color: #999999;  /* Faded grey text when unchecked */
    background-color: transparent;  /* Transparent background */
    border: 1px transparent;  /* Optional white border on hover when checked */
    border-radius: 4px;
    padding: 1px -4px;  /* Small padding to center icon */
    margin: 0px;
    qproperty-iconSize: 20px 15px;  /* Make icon larger */
    image: url(&quot;:/icons/settings_icon.png&quot;); /* Default icon */
}

QPushButton:checked {
    border: 1px solid #00f7c8;  /* Optional white border on hover when checked */
    image: url(&quot;:/icons/settings_icon_checked.png&quot;);
}

/* Hover keeps normal icon, optional glow or border */
QPushButton:checked:pressed {
    border: 2px solid #00f7c8;  /* Optional white border on hover when checked */
    image: url(&quot;:/icons/settings_icon_checked.png&quot;);
}

/* Hover keeps normal icon, optional glow or border */
QPushButton:hover {
    border: none;
    background-color: transparent;
}


/* Pressed version of the icon */
QPushButton:pressed {
    image: url(&quot;:/icons/settings_icon_pressed.png&quot;);
    background-color: transparent;
    border: none;
}


QPushButton:hover:checked {
    border: 1px solid #00f7c8;  /* Optional white border on hover when checked */
}
</string>
             </property>
             <property name="text">
              <string/>
             </property>
             <property name="checkable">
              <bool>true</bool>
             </property>
             <property name="checked">
              <bool>true</bool>
             </property>
            </widget>

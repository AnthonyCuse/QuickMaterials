           <item>
            <widget class="QComboBox" name="materialComboBox">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Material type to create new materials with. Settings are applied to appropriate attributes per material type.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="styleSheet">
              <string notr="true">QComboBox {
    font-family: 'Segoe UI';
    font-size: 14px;
    color: #ffffff;
    background-color: #333333;  /* Matching background color with QPushButton */
    border-radius: 6px;
    padding: 1px 2px;  /* Top/Bottom = 2px, Left/Right = 10px */
    padding-left: 10px;  /* Add more padding to the left for spacing */
	margin: 2px 2px;
}

QComboBox:hover {
    background-color: #5a5a5a;  /* Same hover effect as QPushButton */
}

QComboBox::drop-down {
    border-left: 0px solid #666666;
    width: 0px;  /* Adjust the size of the drop-down button */
    background-color: #333333;
    border-radius: 2px;
    padding: 0px 0px;
}

QComboBox::down-arrow {
    image: url(:/arrow-down.png);  /* Use your actual image file or a built-in Qt arrow */
    width: 10px;  /* Set the width of the arrow */
    height: 10px;  /* Set the height of the arrow */
}

QComboBox::down-arrow:hover {
    image: url(:/arrow-down-hover.png);  /* Optional: arrow image for hover state */
}

QComboBox QAbstractItemView {
    font-family: 'Segoe UI';
    font-size: 14px;
    color: #ffffff;
    background-color: #262626;  /* Darker background for the drop-down menu */
    border: 2px solid #666666;
    border-radius: 4px;
    selection-background-color: #5a5a5a;  /* Highlight selected item */
    selection-color: #ffffff;
    padding: 2px 10px;
}

QComboBox::disabled {
    color: #cccccc;
    border: 1px solid #555555;
    background-color: #7a7a7a;
}
</string>
             </property>
             <property name="sizeAdjustPolicy">
              <enum>QComboBox::AdjustToContents</enum>
             </property>

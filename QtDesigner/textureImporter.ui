                    <bool>false</bool>
                   </property>
                   <property name="styleSheet">
                    <string notr="true">QSlider {
    padding: 0px;
    border: #333333;  /* Clean slider background */
    background: #404040;  /* Avoid filling behind groove */
    border-radius: 6px;
    height:15px;
    width: 10px;   
}

QSlider::groove:horizontal {
    border: 0px;
    height:4px;  /* Groove height (make this smaller for thinner bar) */
    background: #262626;
    border-radius: 2px;
}


QSlider::handle:horizontal {
    background: #e0e0e0;
    border: 1px solid #555555;
    width: 10px;        /* Round handle size */
    height: 10px;
    margin: -4px 0;     /* Centers the handle on thin groove */
    border-radius: 5px; /* Fully rounded handle */

}

QSlider::handle:horizontal:hover {
    background: #ffffff;
}

QSlider::handle:horizontal:pressed {
    background: #aaaaaa;
}

QSlider::add-page:horizontal {
    background: #222222;
}

QSlider::sub-page:horizontal {
    background: #777777;
}
</string>

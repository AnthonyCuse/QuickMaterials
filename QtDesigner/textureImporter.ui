           <item>
            <widget class="QComboBox" name="materialComboBox">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Material type to create new materials with. Settings are applied to appropriate attributes per material type.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="styleSheet">
              <string notr="true">QComboBox {
    font-family: 'Segoe UI';
    font-size: 12px;
    color: #ffffff;
    background-color: #333333;  /* Matching background color with QPushButton */
    border-radius: 6px;
    padding: 1px 2px;  /* Top/Bottom = 2px, Left/Right = 10px */
    padding-left: 10px;  /* Add more padding to the left for spacing */
	margin: 2px 2px;
}

QComboBox:hover {
    background-color: #222222;  /* Same hover effect as QPushButton */
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 14px;                   /* Match QDoubleSpinBox arrow width area */
    border: none;
    background: transparent;       /* Keep clean look */
    margin-right: 0px;
    padding: 0;
}

QComboBox::down-arrow {
    image: url(&quot;:/icons/arrow_combo_box.png&quot;); 
    width: 10px; 
    height: 10px; 
    margin: 0px 5px -2 0;         /* Matches QDoubleSpinBox arrow alignment */
}

/* Optional pressed / hover variants to match QDoubleSpinBox */
QComboBox::down-arrow:pressed {
    image: url(&quot;:/icons/arrow_combo_box.png&quot;);
}

QComboBox QAbstractItemView {
    font-family: 'Segoe UI';
    font-size: 14px;
    color: #ffffff;
    background-color: #262626;  /* Darker background for the drop-down menu */
    border: 2px solid #666666;
    border-radius: 4px;
    selection-background-color: #5a5a5a;  /* Highlight selected item */
    selection-color: #ffffff;
    padding: 2px 10px;
}

QComboBox::disabled {
    color: #cccccc;
    border: 1px solid #555555;
    background-color: #7a7a7a;
}
</string>
             </property>

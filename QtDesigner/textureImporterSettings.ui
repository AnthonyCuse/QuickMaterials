               <property name="toolTip">
                <string/>
               </property>
               <property name="styleSheet">
                <string notr="true">QLineEdit {
    font-family: 'Segoe UI';
    font-size: 11px;
    color: #ffffff;
    background-color: #333333;  /* Retaining the original background color */
    border: 2px solid #444444;
    border-radius: 8px;
    padding: 2px 5px;
}

QLineEdit:hover {
    background-color: #222222;
}


QLineEdit:focus {
    border: 2px solid #555555;
    background-color: #4a4a4a;
}

/* make disabled line edits look greyed-out */
QLineEdit:disabled {
    color: #777777;
    background-color: #555555;
    border: 2px solid #666666;
}

QLabel {
    font-family: 'Segoe UI';
    font-size: 14px;  /* Same larger font size as QLineEdit */
    color: #ffffff;
    background-color: #444444;  /* Matching background color */
    border: 2px solid #444444;
    border-radius: 8px;
    padding: 4px 10px;
}

QLabel:hover {
    background-color: #3a3a3a;
}</string>
